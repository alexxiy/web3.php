{
    "name": "alexxiy/web3.php",
    "description": "Ethereum web3 interface. Maintained fork of web3p/web3.php: phpseclib 4, react/promise 3, current dependencies.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "sc0Vu",
            "email": "alk03073135@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.15.2",
        "kornrunner/keccak": "^1.1",
        "phpseclib/phpseclib": "^4.0.2",
        "react/http": "^1.11.1",
        "react/async": "^4.3",
        "react/promise": "^3.3",
        "react/event-loop": "^1.6",
        "react/socket": "^1.17",
        "ratchet/pawl": "^0.4.3",
        "react/promise-timer": "^1.11"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.5|^12.0|^13.0"
    },
    "replace": {
        "web3p/web3.php": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Web3\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Test\\": "test/"
        }
    }
}
